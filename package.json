{
  "name": "appsfly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint eslint.config.js vite.config.js vitest.config.ts playwright.config.ts middleware.ts e2e src/**/*.ts src/**/*.tsx src/config/env.js src/config/seoConfig.js src/utils/apiErrors.js",
    "preview": "vite preview",
    "generate:roadmap-pdf": "node scripts/run-generate-roadmap-pdf.js",
    "screenshot:register-mobile": "node scripts/capture-register-mobile.mjs",
    "format": "prettier --write eslint.config.js vite.config.js vitest.config.ts playwright.config.ts middleware.ts e2e src/**/*.ts src/**/*.tsx src/config/env.js src/config/seoConfig.js src/utils/apiErrors.js .github/**/*.yml package.json tsconfig.json vercel.json",
    "format:check": "prettier --check eslint.config.js vite.config.js vitest.config.ts playwright.config.ts middleware.ts e2e src/**/*.ts src/**/*.tsx src/config/env.js src/config/seoConfig.js src/utils/apiErrors.js .github/**/*.yml package.json tsconfig.json vercel.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "lint:legacy": "eslint ."
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@react-pdf/renderer": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.25",
    "html5-qrcode": "^2.3.8",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.6.0",
    "sweetalert2": "^11.22.4",
    "sweetalert2-react-content": "^5.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
