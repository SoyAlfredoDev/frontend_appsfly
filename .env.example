# AppsFly Frontend — variables de entorno (Vite)
# Copiar a .env (local) o configurar en Vercel/Netlify (producción).

# Vite determina development/production mediante el comando ejecutado.
VITE_APP_NAME="Appsfly"
VITE_DEFAULT_LANGUAGE="es"

# Backend local usado únicamente por el proxy de Vite.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# API pública usada únicamente al compilar para producción.
VITE_API_URL=https://api.appsfly.cl/api
# El service worker permanece desactivado en desarrollo salvo pruebas explícitas.
VITE_ENABLE_PWA_DEV=false
# URL pública del frontend (SEO / Open Graph — og:url y og:image absolutas)
# Producción: https://appsfly.cl
VITE_FRONTEND_URL=http://localhost:5173

# Mercado Pago Chile — SOLO clave pública (segura en el cliente)
# Credenciales de prueba: Tus integraciones > Credenciales de prueba
# Producción: Credenciales de producción
VITE_MERCADO_PAGO_PUBLIC_KEY=

# Cloudinary (opcional)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Cola tareas agente — mismo valor que AGENT_TASKS_LOCAL_TOKEN en backend/.env (solo esta PC)
# No subir a Vercel/producción si quieres bloquear gestión fuera de tu máquina local.
VITE_AGENT_TASKS_LOCAL_TOKEN=
